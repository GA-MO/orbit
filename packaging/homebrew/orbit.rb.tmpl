# typed: true
# frozen_string_literal: true

# Rendered by scripts/tap.sh from a GitHub release — do not edit the copy in
# the tap by hand; edit this template and re-run the release.
class Orbit < Formula
  desc "Phone-side console for the coding agents on your Mac"
  homepage "https://github.com/@@REPO@@"
  version "@@VERSION@@"
  license "@@LICENSE@@"

  on_macos do
    on_arm do
      url "https://github.com/@@REPO@@/releases/download/v@@VERSION@@/orbit-darwin-arm64"
      sha256 "@@SHA_ARM64@@"
    end
    on_intel do
      url "https://github.com/@@REPO@@/releases/download/v@@VERSION@@/orbit-darwin-x64"
      sha256 "@@SHA_X64@@"
    end
  end

  def install
    binary = Dir["orbit-darwin-*"].first
    bin.install binary => "orbit"
  end

  # `brew services start orbit` keeps the server up across logins. It runs
  # without a login shell, which is fine: agents are launched through one.
  service do
    run [opt_bin/"orbit"]
    keep_alive true
    log_path var/"log/orbit.log"
    error_log_path var/"log/orbit.log"
  end

  def caveats
    <<~EOS
      Next:
        orbit doctor    what this Mac has and is missing
        orbit setup     wire the hooks and MCP server into Claude Code
        orbit phone     run it, published over your tailnet as https
    EOS
  end

  test do
    assert_equal "@@VERSION@@", shell_output("#{bin}/orbit version").strip
  end
end
